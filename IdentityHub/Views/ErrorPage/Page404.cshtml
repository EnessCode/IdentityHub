@{
    Layout = null;
    ViewData["Title"] = "404 - Sayfa Bulunamadı";
}

<div class="form-element-area" style="margin-top: 60px; margin-bottom: 60px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 col-sm-12">
                <div class="form-element-list text-center" style="background-color: #fff; padding: 60px 40px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                    <h1 style="font-size: 100px; font-weight: 700; color: #00c292; margin-bottom: 10px;">404</h1>
                    <h2 style="font-size: 24px; color: #333; margin-bottom: 20px;">Aradığınız Sayfa Bulunamadı</h2>
                    <p style="color: #6c757d; font-size: 15px; margin-bottom: 30px;">
                        Ulaşmaya çalıştığınız sayfa silinmiş, adı değiştirilmiş veya geçici olarak kullanım dışı olabilir.
                    </p>
                    <a href="/Message/Inbox" class="btn" style="background-color: #00c292; color: #ffffff; padding: 10px 30px; font-size: 16px; border-radius: 4px; display: inline-block; text-decoration: none; border: none; transition: all 0.3s;">
                        <i class="notika-icon notika-house" style="margin-right: 5px;"></i> Ana Sayfaya Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>