@using IdentityHub.Models.User
@model RegisterViewModel
@{
	Layout = null;
}

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<title>Identity Kayıt Formu</title>
	<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
	<link rel="stylesheet" type="text/css" href="/colorlib-regform-35/css/nunito-font.css">
	<link rel="stylesheet" href="/colorlib-regform-35/css/style.css" />
</head>
<body class="form-v9">
	<div class="page-content">
		<div class="form-v9-content" style="background-image: url('/colorlib-regform-35/images/form-v9.jpg')">
			<form class="form-detail" method="post">
				<h2>Yeni Kullanıcı Kaydı</h2>

				<div class="form-row-total">
					<div class="form-row">
						<input type="text" class="input-text" asp-for="Name" placeholder="Adınız" required>
					</div>
					<div class="form-row">
						<input type="text" class="input-text" asp-for="Surname" placeholder="Soyadınız" required>
					</div>
				</div>
				<div class="form-row-total">
					<div class="form-row">
						<input type="email" class="input-text" asp-for="Email" placeholder="Mail Adresiniz" required>
					</div>
					<div class="form-row">
						<input type="text" class="input-text" asp-for="Username" placeholder="Kullanıcı Adınız" required>
					</div>
				</div>
				<div class="form-row-total">
					<div class="form-row">
						<input type="password" class="input-text" asp-for="Password" placeholder="Şifreniz" required>
					</div>
					<div class="form-row">
						<input type="password" class="input-text" asp-for="ConfirmPassword" placeholder="Şifre Tekrarı" required>
					</div>
				</div>

				<div asp-validation-summary="All" style="color: #ff4d4d; margin-bottom: 20px; font-family: 'Nunito', sans-serif; padding-left: 30px; font-weight: 600;"></div>

				<div class="form-row-last" style="display: flex; flex-direction: column; align-items: center; gap: 15px;">
					<input type="submit" class="register" value="Kayıt Ol" style="width: 100%;">
					<a href="/Login/Index" style="color: #fff; text-decoration: none; font-family: 'Nunito', sans-serif; font-size: 15px;">Zaten hesabınız var mı? <strong>Giriş Yap</strong></a>
				</div>
			</form>
		</div>
	</div>
</body>
</html>