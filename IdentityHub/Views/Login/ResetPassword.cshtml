@using IdentityHub.Models.User
@model ResetPasswordViewModel
@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
	<title>Şifreyi Sıfırla</title>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<link rel="icon" type="image/png" href="/Login_v4/images/icons/favicon.ico" />
	<link rel="stylesheet" type="text/css" href="/Login_v4/vendor/bootstrap/css/bootstrap.min.css">
	<link rel="stylesheet" type="text/css" href="/Login_v4/fonts/font-awesome-4.7.0/css/font-awesome.min.css">
	<link rel="stylesheet" type="text/css" href="/Login_v4/fonts/iconic/css/material-design-iconic-font.min.css">
	<link rel="stylesheet" type="text/css" href="/Login_v4/css/util.css">
	<link rel="stylesheet" type="text/css" href="/Login_v4/css/main.css">
</head>
<body>

	<div class="limiter">
		<div class="container-login100" style="background-image: url('/Login_v4/images/bg-01.jpg');">
			<div class="wrap-login100 p-l-55 p-r-55 p-t-65 p-b-54">
				<form class="login100-form validate-form" method="post" asp-action="ResetPassword" asp-controller="Login">
					<span class="login100-form-title p-b-49">
						Yeni Şifre Belirle
					</span>

					<div class="text-danger p-b-20" asp-validation-summary="All"></div>

					<input type="hidden" asp-for="UserId" />
					<input type="hidden" asp-for="Token" />

					<div class="wrap-input100 validate-input m-b-23">
						<span class="label-input100">Yeni Şifre</span>
						<input class="input100" type="password" asp-for="NewPassword" placeholder="Yeni şifrenizi girin">
						<span class="focus-input100" data-symbol="&#xf190;"></span>
						<span asp-validation-for="NewPassword" class="text-danger" style="font-size:12px;"></span>
					</div>

					<div class="wrap-input100 validate-input m-b-23">
						<span class="label-input100">Şifre Tekrar</span>
						<input class="input100" type="password" asp-for="ConfirmPassword" placeholder="Şifrenizi tekrar girin">
						<span class="focus-input100" data-symbol="&#xf190;"></span>
						<span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:12px;"></span>
					</div>

					<div class="container-login100-form-btn p-t-15">
						<div class="wrap-login100-form-btn">
							<div class="login100-form-bgbtn"></div>
							<button class="login100-form-btn" type="submit">
								Şifremi Güncelle
							</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>

	<script src="/Login_v4/vendor/jquery/jquery-3.2.1.min.js"></script>
	<script src="/Login_v4/vendor/bootstrap/js/bootstrap.min.js"></script>
	<script src="/Login_v4/js/main.js"></script>

</body>
</html>