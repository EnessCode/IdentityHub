@model List<Message>

@{
	ViewData["Title"] = "Profil";
}

<div class="form-element-area">
	<div class="container">
		<div class="row">
			<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
				<div class="form-element-list">
					<div class="basic-tb-hd">
						<h2>Profili Düzenle</h2>
						<p>Lütfen bilgilerinizi eksiksiz doldurun ve güncelleme işlemini tamamlayın.</p>
					</div>
					<form method="post">
						<div class="row">
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="text" class="form-control" placeholder="Adınız">
									</div>
								</div>
							</div>
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="text" class="form-control" placeholder="Soyadınız">
									</div>
								</div>
							</div>
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="text" class="form-control" placeholder="Şehriniz">
									</div>
								</div>
							</div>
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="text" class="form-control" placeholder="Fotoğraf URL">
									</div>
								</div>
							</div>
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="text" class="form-control" placeholder="Kullanıcı Adınız">
									</div>
								</div>
							</div>
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="text" class="form-control" placeholder="Mail Adresiniz">
									</div>
								</div>
							</div>
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="text" class="form-control" placeholder="Telefon Numaranız">
									</div>
								</div>
							</div>
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="password" class="form-control" placeholder="Şifreniz">
									</div>
								</div>
							</div>
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="password" class="form-control" placeholder="Şifre Tekrarı">
									</div>
								</div>
							</div>
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<button class="btn btn-success">Bilgileri Güncelleyin</button>
									</div>
								</div>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>