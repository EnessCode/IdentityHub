@using IdentityHub.Models.User
@model UserEditViewModel
@{
	ViewData["Title"] = "Profil";
}

<div class="form-element-area">
	<div class="container">
		<div class="row">
			<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
				<div class="form-element-list">
					<div class="basic-tb-hd">
						<h2>Profili Düzenle</h2>
						<p>Lütfen bilgilerinizi eksiksiz doldurun ve güncelleme işlemini tamamlayın.</p>
					</div>
					<form method="post">
						<div class="text-danger p-b-20" asp-validation-summary="All"></div>

						<div class="row">
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="text" asp-for="Name" class="form-control" placeholder="Adınız">
									</div>
								</div>
							</div>
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="text" asp-for="Surname" class="form-control" placeholder="Soyadınız">
									</div>
								</div>
							</div>
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="text" asp-for="City" class="form-control" placeholder="Şehriniz">
									</div>
								</div>
							</div>
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="text" asp-for="ImageUrl" class="form-control" placeholder="Fotoğraf URL">
									</div>
								</div>
							</div>
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="text" asp-for="Username" class="form-control" placeholder="Kullanıcı Adınız" readonly>
									</div>
								</div>
							</div>

							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="email" asp-for="Email" class="form-control" placeholder="Mail Adresiniz">
									</div>
								</div>
							</div>

							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="text" asp-for="PhoneNumber" class="form-control" placeholder="Telefon Numaranız">
									</div>
								</div>
							</div>
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="password" asp-for="Password" class="form-control" placeholder="Şifreniz (Değiştirmek istemiyorsanız boş bırakın)">
									</div>
								</div>
							</div>
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Şifre Tekrarı">
										<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
									</div>
								</div>
							</div>
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<button type="submit" class="btn btn-success">Bilgileri Güncelleyin</button>
									</div>
								</div>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>