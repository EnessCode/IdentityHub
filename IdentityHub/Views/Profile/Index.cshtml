@using IdentityHub.Models.User
@model UserEditViewModel
@{
	ViewData["Title"] = "Profil";
}

<div class="form-element-area" style="margin-top: 30px; margin-bottom: 30px;">
	<div class="container">
		<div class="row">
			<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
				<div class="form-element-list" style="background-color: #fff; padding: 40px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">

					<div class="basic-tb-hd" style="margin-bottom: 30px; border-bottom: 1px solid #f0f0f0; padding-bottom: 15px;">
						<h2 style="margin: 0; color: #2c3e50; font-size: 24px;">Profili Düzenle</h2>
						<p style="margin: 8px 0 0 0; color: #6c757d; font-size: 14px;">Lütfen bilgilerinizi eksiksiz doldurun ve güncelleme işlemini tamamlayın.</p>
					</div>

					<form method="post">
						<div class="text-danger p-b-20" asp-validation-summary="All"></div>

						<div class="row">
							<div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-bottom: 20px;">
								<div class="form-group">
									<label style="font-weight: 500; color: #555;">Adınız</label>
									<div class="nk-int-st">
										<input type="text" asp-for="Name" class="form-control" placeholder="Adınız">
									</div>
								</div>
							</div>

							<div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-bottom: 20px;">
								<div class="form-group">
									<label style="font-weight: 500; color: #555;">Soyadınız</label>
									<div class="nk-int-st">
										<input type="text" asp-for="Surname" class="form-control" placeholder="Soyadınız">
									</div>
								</div>
							</div>

							<div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-bottom: 20px;">
								<div class="form-group">
									<label style="font-weight: 500; color: #555;">Şehriniz</label>
									<div class="nk-int-st">
										<input type="text" asp-for="City" class="form-control" placeholder="Şehriniz">
									</div>
								</div>
							</div>

							<div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-bottom: 20px;">
								<div class="form-group">
									<label style="font-weight: 500; color: #555;">Kullanıcı Adınız</label>
									<div class="nk-int-st">
										<input type="text" asp-for="Username" class="form-control" placeholder="Kullanıcı Adınız" readonly style="background-color: #f8f9fa; cursor: not-allowed;">
									</div>
								</div>
							</div>

							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-bottom: 20px;">
								<div class="form-group">
									<label style="font-weight: 500; color: #555;">Fotoğraf URL</label>
									<div class="nk-int-st">
										<input type="text" asp-for="ImageUrl" class="form-control" placeholder="Fotoğraf URL (Opsiyonel)">
									</div>
								</div>
							</div>

							<div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-bottom: 20px;">
								<div class="form-group">
									<label style="font-weight: 500; color: #555;">E-Posta Adresiniz</label>
									<div class="nk-int-st">
										<input type="email" asp-for="Email" class="form-control" placeholder="Mail Adresiniz">
									</div>
								</div>
							</div>

							<div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-bottom: 20px;">
								<div class="form-group">
									<label style="font-weight: 500; color: #555;">Telefon Numaranız</label>
									<div class="nk-int-st">
										<input type="text" asp-for="PhoneNumber" class="form-control" placeholder="Telefon Numaranız">
									</div>
								</div>
							</div>

							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-bottom: 20px;">
								<hr style="border-top: 1px dashed #ddd; margin: 10px 0 25px 0;">
							</div>

							<div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-bottom: 20px;">
								<div class="form-group">
									<label style="font-weight: 500; color: #555;">Yeni Şifre</label>
									<div class="nk-int-st">
										<input type="password" asp-for="Password" class="form-control" placeholder="Değiştirmek istemiyorsanız boş bırakın">
									</div>
								</div>
							</div>

							<div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="margin-bottom: 20px;">
								<div class="form-group">
									<label style="font-weight: 500; color: #555;">Şifre Tekrarı</label>
									<div class="nk-int-st">
										<input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Yeni şifrenizi tekrar girin">
										<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
									</div>
								</div>
							</div>

							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top: 10px; text-align: right;">
								<div class="form-group">
									<button type="submit" class="btn btn-success" style="padding: 10px 30px; font-size: 15px;">Bilgileri Güncelle</button>
								</div>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>