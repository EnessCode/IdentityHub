@using IdentityHub.Models.Message
@model List<MessageWithUserInfoViewModel>

<div class="hd-mg-tt">
    <h2>Mesajlar</h2>
</div>
<div class="hd-message-info">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <a href="#">
                <div class="hd-message-sn">
                    <div class="hd-message-img" style="width: 50px; text-align: center;">
                        <img src="@item.ImageUrl" alt="" style="width: 40px; height: 40px; object-fit: cover; border-radius: 50%;" />
                    </div>
                    <div class="hd-mg-ctn">
                        <h3>@item.FulName</h3>
                        <p>@item.Subject</p>
                    </div>
                </div>
            </a>
        }
    }
    else
    {
        <div style="padding: 15px; text-align: center; color: #888;">
            <p>Yeni mesajınız bulunmuyor</p>
        </div>
    }
</div>
<div class="hd-mg-va">
    <a href="/Message/Inbox/">Tümünü Gör</a>
</div>