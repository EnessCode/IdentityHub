@using IdentityHub.Entities
@model List<Notification>

<div class="hd-mg-tt">
    <h2>Bildirimler</h2>
</div>
<div class="hd-message-info">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <a href="#">
                <div class="hd-message-sn">
                    <div class="hd-message-img" style="width: 50px; text-align: center;">
                        <img src="@item.ImageUrl" alt="" style="width: 40px; height: 40px; object-fit: cover; border-radius: 50%;" />
                    </div>
                    <div class="hd-mg-ctn">
                        <p>@item.Detail</p>
                        <span style="font-size: 11px; color: #aaa;">@item.SendDate.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                </div>
            </a>
        }
    }
    else
    {
        <div style="padding: 15px; text-align: center; color: #888;">
            <p>Yeni bildirim bulunmuyor</p>
        </div>
    }
</div>
<div class="hd-mg-va">
    <a href="/Notifications/Index/">Tümünü Gör</a>
</div>