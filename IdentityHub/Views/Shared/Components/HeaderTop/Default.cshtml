@using IdentityHub.Models.Layout
@model HeaderTopViewModel

<div class="header-top-area">
	<div class="container">
		<div class="row">
			<div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
				<div class="logo-area">
					<a href="#"><img src="/notika-master/notika/green-horizotal/img/logo/logo.png" alt="" /></a>
				</div>
			</div>
			<div class="col-lg-8 col-md-8 col-sm-12 col-xs-12">
				<div class="header-top-menu">
					<ul class="nav navbar-nav notika-top-nav">

						<li class="nav-item dropdown">
							<a href="#" data-toggle="dropdown" role="button" aria-expanded="false" class="nav-link dropdown-toggle"><span><i class="notika-icon notika-search"></i></span></a>
							<div role="menu" class="dropdown-menu search-dd animated flipInX">
								<div class="search-input">
									<i class="notika-icon notika-left-arrow"></i>
									<input type="text" placeholder="Arama yap..." />
								</div>
							</div>
						</li>

                        <li class="nav-item dropdown">
                            <a href="#" data-toggle="dropdown" role="button" aria-expanded="false" class="nav-link dropdown-toggle" style="position: relative;">
                                <span><i class="notika-icon notika-mail"></i></span>

                                @if (Model.MessageCount > 0)
                                {
                                    <span style="position: absolute; top: 12px; right: 8px; background: #ed5565; color: #fff; border-radius: 10px; min-width: 18px; height: 18px; line-height: 18px; text-align: center; font-size: 10px; font-weight: bold; padding: 0 4px;">
                                        @Model.MessageCount
                                    </span>
                                }
                            </a>

                            <div role="menu" class="dropdown-menu message-dd animated zoomIn">
                                @await Component.InvokeAsync("MessageHeaderTop")
                            </div>
                        </li>

                        <li class="nav-item nc-al">
                            <a href="#" data-toggle="dropdown" role="button" aria-expanded="false" class="nav-link dropdown-toggle" style="position: relative;">
                                <span><i class="notika-icon notika-alarm"></i></span>

                                @if (Model.NotificationCount > 0)
                                {
                                    <span style="position: absolute; top: 12px; right: 8px; background: #ed5565; color: #fff; border-radius: 10px; min-width: 18px; height: 18px; line-height: 18px; text-align: center; font-size: 10px; font-weight: bold; padding: 0 4px;">
                                        @Model.NotificationCount
                                    </span>
                                }
                            </a>

                            <div role="menu" class="dropdown-menu message-dd notification-dd animated zoomIn">
                                @await Component.InvokeAsync("NotificationHeaderTop")
                            </div>
                        </li>

					</ul>
				</div>
			</div>
		</div>
	</div>
</div>