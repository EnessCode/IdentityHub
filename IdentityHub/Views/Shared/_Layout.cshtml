<!doctype html>
<html class="no-js" lang="">

@await Html.PartialAsync("_HeadPartial")

<body>
	@await Component.InvokeAsync("HeaderTop")

	@await Html.PartialAsync("_MobileMenuPartial")

	@await Html.PartialAsync("_MainMenuPartial")

	@await Html.PartialAsync("_BreadcombPartial")

	@RenderBody()

	@await Html.PartialAsync("_FooterPartial")

	@await Html.PartialAsync("_ScriptPartial")

	@RenderSection("Scripts", required: false)
</body>

</html>